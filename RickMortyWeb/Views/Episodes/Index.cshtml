@model List<RickMortyWeb.Models.Episode>

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rick & Morty | Episodios</title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #0b0f14;
                color: white;
            }

            /* HEADER */

            .hero {
                min-height: 360px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 50px 20px;
                background: radial-gradient(circle at top, #243b2a, #10161d 55%, #080b0f);
            }

            .hero-content {
                max-width: 800px;
            }

            .hero h1 {
                margin: 0;
                font-size: 64px;
                font-weight: 800;
                color: #7cff6b;
                text-shadow: 0 0 25px rgba(124, 255, 107, 0.35);
            }

            .hero h2 {
                margin: 10px 0;
                font-size: 28px;
                color: white;
            }

            .hero p {
                color: #aeb8c4;
                font-size: 18px;
                line-height: 1.6;
            }

            /* CONTENEDOR */

            .container {
                max-width: 1250px;
                margin: auto;
                padding: 50px 25px;
            }

            .title {
                text-align: center;
                margin-bottom: 40px;
            }

                .title h2 {
                    font-size: 32px;
                    margin-bottom: 10px;
                }

                .title p {
                    color: #8d98a6;
                }

            /* GRID */

            .episodes {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 25px;
            }

            /* CARD */

            .card {
                position: relative;
                background: linear-gradient( 145deg, #18212b, #111820 );
                border: 1px solid #28333f;
                border-radius: 18px;
                padding: 28px;
                transition: all 0.25s ease;
                overflow: hidden;
            }

                .card::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 4px;
                    background: #7cff6b;
                }

                .card:hover {
                    transform: translateY(-8px);
                    border-color: #7cff6b;
                    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.45), 0 0 20px rgba(124, 255, 107, 0.08);
                }

            /* NUMERO */

            .episode-number {
                color: #7cff6b;
                font-size: 14px;
                font-weight: bold;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            /* TITULO */

            .card h3 {
                font-size: 23px;
                margin: 12px 0 20px;
                color: white;
            }

            /* INFORMACION */

            .info {
                display: flex;
                justify-content: space-between;
                gap: 15px;
                padding: 12px 0;
                border-top: 1px solid #28333f;
            }

                .info:last-of-type {
                    border-bottom: 1px solid #28333f;
                }

            .label {
                color: #7f8a98;
                font-size: 14px;
            }

            .value {
                color: #e8edf2;
                font-weight: bold;
                text-align: right;
            }

            /* BADGE */

            .badge {
                display: inline-block;
                margin-top: 20px;
                padding: 7px 12px;
                border-radius: 20px;
                background: rgba(124, 255, 107, 0.1);
                border: 1px solid rgba(124, 255, 107, 0.25);
                color: #7cff6b;
                font-size: 13px;
                font-weight: bold;
            }

            /* FOOTER */

            footer {
                text-align: center;
                padding: 35px 20px;
                border-top: 1px solid #202a34;
                color: #697482;
                margin-top: 30px;
            }

            /* RESPONSIVE */

            @@media (max-width: 600px) {

                .hero h1 {
                    font-size: 42px;
                }

                .hero h2 {
                    font-size: 22px;
                }

                .container {
                    padding: 30px 15px;
                }
            }

    </style>

</head>

<body>

    <!-- HERO -->

    <section class="hero">

        <div class="hero-content">

            <h1>🛸 Rick & Morty</h1>

            <h2>Explora los episodios</h2>

            <p>
                Consulta la información de los episodios
                obtenida desde nuestra API.
            </p>

        </div>

    </section>


    <!-- CONTENIDO -->

    <main class="container">

        <div class="title">

            <h2>📺 Episodios</h2>

            <p>
                Se encontraron @Model.Count episodios
            </p>

        </div>


        <div class="episodes">

            @foreach (var episode in Model)
            {

                <article class="card">

                    <div class="episode-number">

                        Episodio #@episode.Id

                    </div>


                    <h3>

                        @episode.Name

                    </h3>


                    <div class="info">

                       
                        <span class="value">
                            @episode.Episodee
                        </span>

                    </div>


                    <div class="info">

                        <span class="label">
                            Fecha de emisión
                        </span>

                        <span class="value">
                            @episode.Air_Date
                        </span>

                    </div>


                    <div class="info">

                        <span class="label">
                            ID
                        </span>

                        <span class="value">
                            @episode.Id
                        </span>

                    </div>


                    <div class="badge">

                        🛸 Rick & Morty

                    </div>

                </article>

            }

        </div>

    </main>


    <footer>

        Rick & Morty Web
        <br />

        Datos proporcionados por nuestra API

    </footer>

</body>

</html>