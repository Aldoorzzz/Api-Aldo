@model List<Api_Aldo.Models.Episode>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rick & Morty | Episodios</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #10141b;
                color: white;
            }

            .header {
                background: #1b2330;
                padding: 40px 20px;
                text-align: center;
                border-bottom: 3px solid #4caf50;
            }

            .header h1 {
                margin: 0;
                font-size: 42px;
                color: #7cff6b;
            }

            .header p {
                margin-top: 10px;
                color: #bfc7d5;
                font-size: 18px;
            }

            .container {
                max-width: 1200px;
                margin: 40px auto;
                padding: 0 20px;
            }

            .episodes {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 25px;
            }

            .card {
                background: #1c2533;
                border-radius: 15px;
                padding: 25px;
                border: 1px solid #303b4d;
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            }

            .episode-code {
                color: #7cff6b;
                font-weight: bold;
                font-size: 15px;
            }

            .card h2 {
                margin: 12px 0;
                font-size: 23px;
            }

            .date {
                color: #aeb7c5;
                margin-bottom: 20px;
            }

            .button {
                display: inline-block;
                padding: 10px 18px;
                background: #7cff6b;
                color: #10141b;
                text-decoration: none;
                border-radius: 8px;
                font-weight: bold;
            }

            .button:hover {
                background: #b1ffa7;
            }
    </style>
</head>

<body>

    <div class="header">
        <h1>🛸 Rick & Morty</h1>
        <p>Explora los episodios de la serie</p>
    </div>

    <div class="container">

        <div class="episodes">

            @foreach (var episode in Model)
            {
                <div class="card">

                    <div class="episode-code">
                        @episode.Episodio
                    </div>

                    <h2>
                        @episode.Name
                    </h2>

                    <div class="date">
                        📅 @episode.Air_Date
                    </div>

                    <a href="/api/episodes/@episode.Id"
                       target="_blank"
                       class="button">
                        Ver episodio
                    </a>

                </div>
            }

        </div>

    </div>

</body>
</html>